# Copy to .env in the repository root. Never commit actual secrets.
DATABASE_URL=postgresql+psycopg://casepilot:casepilot@localhost:5432/casepilot
DEMO_MODE=true
# Set a random operator password/token, at least 16 characters.
OPERATOR_TOKEN=replace-with-a-long-random-secret=http://localhost:3000
# Next.js server-side variables (not NEXT_PUBLIC_ secrets).
BACKEND_URL=http://127.0.0.1:8000
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional; blank model uses explicit deterministic demo analysis.
LLM_MODEL=
OPENAI_API_KEY=
SALESFORCE_MODE=demo
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=v64.0
# Configure org picklist values and queue IDs; external ID must be unique.
SALESFORCE_EXTERNAL_ID_FIELD=CasePilot_Reference__c
SALESFORCE_STATUS_MAP={}
SALESFORCE_PRIORITY_MAP={}
SALESFORCE_OWNER_MAP={}
SALESFORCE_ORIGIN=Web
